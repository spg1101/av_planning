<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>planning_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, vehicle configs and maps for every platform</description>
  <maintainer email="planning-lead@example.com">Planning Lead</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>planning_nodes</exec_depend>
  <exec_depend>planning_world_model</exec_depend>
  <exec_depend>planning_localization</exec_depend>
  <exec_depend>planning_sim</exec_depend>
  <exec_depend>planning_eval</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
