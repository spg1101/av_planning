# Everything this repo needs besides itself. Import with:  vcs import < planning.repos
# (CARLA itself is not here: the server runs on the AWS instance, and the Python client
#  is installed with pip, matching the server version. See docs/aws_carla.md.)
repositories:
  av_interfaces:
    type: git
    url: git@github.com:<your-org>/av_interfaces.git
    version: main
